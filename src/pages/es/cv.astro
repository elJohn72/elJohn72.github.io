---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvInteractive from '../../components/CvInteractive.astro';
import CredentialsSection from '../../components/CredentialsSection.astro';
import { getUi } from '../../i18n/ui';
import { profile, cv, socialLabels } from '../../lib/data';

const locale = 'es';
const t = getUi(locale);
const primaryCv = profile.cvFiles.find((f) => f.primary) ?? profile.cvFiles[0];
const github = profile.social.github;
---

<BaseLayout locale={locale} title={t.cv.title} description={cv.pitch[locale]} pathname={Astro.url.pathname}>
  <div class="page-shell-narrow">
    <!-- ── Encabezado ─────────────────────────────────────── -->
    <header class="flex flex-col gap-6 border-b border-slate-700/80 pb-8 sm:flex-row sm:items-start sm:gap-8">
      <img
        src={profile.photo}
        alt={profile.name}
        width="160"
        height="160"
        class="h-32 w-32 shrink-0 rounded-xl border-2 border-cyan-500/40 object-cover object-top shadow-glow sm:h-40 sm:w-40"
      />
      <div class="min-w-0 flex-1">
        <p class="section-label">// cv</p>
        <h1 class="mt-2 break-words font-display text-3xl font-bold text-white sm:text-4xl">{profile.name}</h1>
        <p class="mt-2 break-words font-mono text-xs text-cyan-400 sm:text-sm">{cv.headline[locale]}</p>
        <p class="mt-1 font-mono text-[11px] text-slate-500">{cv.location[locale]}</p>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs">
          <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-3 py-1.5 font-semibold text-cyan-300 transition hover:border-cyan-300 hover:bg-cyan-500/20">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            {github.replace('https://', '')}
          </a>
          <a href={`mailto:${profile.email}`} class="break-all text-slate-400 hover:text-cyan-400">{profile.email}</a>
          {Object.entries(profile.social)
            .filter(([key]) => key !== 'github')
            .map(([key, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-cyan-400">
                {socialLabels[key]?.[locale]}
              </a>
            ))}
        </div>

        <div class="no-print mt-5 flex flex-wrap gap-3">
          <a href={primaryCv.file} download class="btn-primary !w-auto !px-5 !py-2.5 !text-xs">{t.cv.download}</a>
          <button type="button" onclick="window.print()" class="btn-secondary !w-auto !px-5 !py-2.5 !text-xs">{t.cv.print}</button>
        </div>
      </div>
    </header>

    <!-- ── CV interactivo ─────────────────────────────────── -->
    <CvInteractive
      locale={locale}
      labels={{
        all: t.cv.all,
        filterHint: t.cv.filterHint,
        search: t.cv.search,
        searchPlaceholder: t.cv.searchPlaceholder,
        noResults: t.cv.noResults,
        experience: t.cv.experience,
        projects: t.cv.projects,
        stack: t.cv.stack,
        education: t.cv.education,
        courses: t.cv.courses,
        languages: t.cv.languages,
        expand: t.cv.expandAll,
        collapse: t.cv.collapseAll,
        expandAll: t.cv.expandAll,
        collapseAll: t.cv.collapseAll,
        current: t.cv.current,
        shareFacet: t.cv.shareFacet,
        copied: t.cv.copied,
        liveSite: t.cv.liveSite,
        repo: t.cv.repo,
        showing: t.cv.showing,
      }}
    />

    <!-- ── Títulos y certificados ─────────────────────────── -->
    <section class="mt-12">
      <h2 class="flex items-center gap-3 font-display text-lg font-bold text-white sm:text-xl">
        {t.sections.credentials}
      </h2>
      <div class="mt-5"><CredentialsSection locale={locale} downloadLabel={t.project.downloadCert} /></div>
    </section>
  </div>
</BaseLayout>
