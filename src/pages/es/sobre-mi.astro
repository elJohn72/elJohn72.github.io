---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import Timeline from '../../components/Timeline.astro';
import { getUi } from '../../i18n/ui';
import { profile } from '../../lib/data';

const locale = 'es';
const t = getUi(locale);
const roleKeys = ['dentistry', 'teaching', 'entrepreneurship', 'robotics'] as const;
const roleTitles: Record<string, string> = {
  dentistry: t.about.dentistry,
  teaching: t.about.teaching,
  entrepreneurship: t.about.entrepreneurship,
  robotics: t.about.robotics,
};
---

<BaseLayout locale={locale} title={t.about.title} description={profile.bio.es} pathname={Astro.url.pathname}>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <p class="section-label">// perfil</p>
    <h1 class="section-title mt-2">{t.about.title}</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">{profile.bio.es}</p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {roleKeys.map((key) => (
        <section class="card-surface">
          <h2 class="font-display text-xl font-bold text-ink-900 dark:text-white">{roleTitles[key]}</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{profile.roles[key][locale]}</p>
        </section>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="section-title">{t.sections.timeline}</h2>
      <div class="mt-8">
        <Timeline locale={locale} />
      </div>
    </section>

    <section class="mt-16">
      <h2 class="section-title">{t.sections.skills}</h2>
      <div class="mt-8">
        <SkillGrid />
      </div>
    </section>
  </div>
</BaseLayout>
