---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProductionSites from '../../components/ProductionSites.astro';
import { getUi } from '../../i18n/ui';
import { profile, getFeaturedProjects } from '../../lib/data';

const locale = 'es';
const t = getUi(locale);
const featured = getFeaturedProjects();
const pathname = Astro.url.pathname;
---

<BaseLayout locale={locale} title="Portafolio" description={profile.bio.es} pathname={pathname}>
  <HeroSection
    locale={locale}
    ctaProjects={t.hero.ctaProjects}
    ctaCv={t.hero.ctaCv}
    ctaContact={t.hero.ctaContact}
  />

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <p class="section-label">// en producción</p>
    <h2 class="section-title mt-2">{t.sections.productionSites}</h2>
    <div class="mt-6"><ProductionSites locale={locale} /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <p class="section-label">// destacados</p>
    <h2 class="section-title mt-2">{t.sections.featured}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
