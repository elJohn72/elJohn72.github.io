---
import '../styles/global.css';
import { localePath } from '../i18n/ui';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 | El John</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-slate-50 p-6 text-center font-sans dark:bg-ink-950">
    <h1 class="text-6xl font-bold text-teal-600">404</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">Página no encontrada / Page not found</p>
    <a href={localePath('es', '/')} class="mt-6 font-semibold text-teal-600 hover:underline">← Inicio / Home</a>
  </body>
</html>
