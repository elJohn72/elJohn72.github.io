---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import Timeline from '../../components/Timeline.astro';
import DegreesBadges from '../../components/DegreesBadges.astro';
import CredentialsSection from '../../components/CredentialsSection.astro';
import ProductionSites from '../../components/ProductionSites.astro';
import { getUi } from '../../i18n/ui';
import { profile } from '../../lib/data';

const locale = 'en';
const t = getUi(locale);
const roleKeys = ['dentalHygiene', 'engineering', 'education', 'teaching', 'entrepreneurship', 'robotics'] as const;
const roleTitles: Record<string, string> = {
  dentalHygiene: t.about.dentalHygiene,
  engineering: t.about.engineering,
  education: t.about.education,
  teaching: t.about.teaching,
  entrepreneurship: t.about.entrepreneurship,
  robotics: t.about.robotics,
};
---

<BaseLayout locale={locale} title={t.about.title} description={profile.bio.en} pathname={Astro.url.pathname}>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[240px_1fr] lg:items-start">
      <img
        src={profile.photo}
        alt={profile.name}
        width="240"
        height="240"
        class="mx-auto h-56 w-56 rounded-xl border-2 border-cyan-500/40 object-cover object-top shadow-glow lg:mx-0"
        loading="eager"
      />
      <div>
        <p class="section-label">// profile</p>
        <h1 class="section-title mt-2">{t.about.title}</h1>
        <p class="mt-3 font-mono text-sm text-cyan-400/90">{profile.title.en}</p>
        <div class="mt-4">
          <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-slate-500">{t.about.degrees}</p>
          <DegreesBadges locale={locale} />
        </div>
        <p class="mt-4 text-lg leading-relaxed text-slate-300">{profile.bio.en}</p>
      </div>
    </div>

    <section class="mt-16">
      <p class="section-label">// sites</p>
      <h2 class="section-title mt-2 text-2xl">{t.sections.productionSites}</h2>
      <div class="mt-6"><ProductionSites locale={locale} /></div>
    </section>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {roleKeys.map((key) => (
        <section class="card-surface">
          <h2 class="font-display text-xl font-bold text-white">{roleTitles[key]}</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{profile.roles[key][locale]}</p>
        </section>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="section-title">{t.sections.timeline}</h2>
      <div class="mt-8">
        <Timeline locale={locale} />
      </div>
    </section>

    <section class="mt-16">
      <h2 class="section-title">{t.sections.skills}</h2>
      <div class="mt-8">
        <SkillGrid />
      </div>
    </section>

    <section class="mt-16">
      <p class="section-label">// credentials</p>
      <h2 class="section-title mt-2">{t.sections.credentials}</h2>
      <div class="mt-8">
        <CredentialsSection locale={locale} downloadLabel={t.project.downloadCert} />
      </div>
    </section>
  </div>
</BaseLayout>
