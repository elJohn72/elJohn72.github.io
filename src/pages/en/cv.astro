---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import { getUi } from '../../i18n/ui';
import { profile, projects } from '../../lib/data';

const locale = 'en';
const t = getUi(locale);
---

<BaseLayout locale={locale} title={t.cv.title} description={profile.bio.en} pathname={Astro.url.pathname}>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <div class="no-print mb-8 flex flex-wrap gap-3">
      <a href="/cv/cv.pdf" download class="btn-primary">{t.cv.download}</a>
      <button type="button" onclick="window.print()" class="btn-secondary">{t.cv.print}</button>
    </div>

    <header class="border-b border-slate-200 pb-8 dark:border-slate-700">
      <h1 class="font-display text-4xl font-bold">{profile.name}</h1>
      <p class="mt-2 text-brand-700 dark:text-brand-300">{profile.title.en}</p>
      <p class="mt-4 text-slate-600 dark:text-slate-300">{profile.bio.en}</p>
      <p class="mt-2 text-sm">
        <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
        <a href={profile.social.github}>GitHub</a> ·
        <a href={profile.social.linkedin}>LinkedIn</a>
      </p>
    </header>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t.sections.timeline}</h2>
      <div class="mt-4"><Timeline locale={locale} /></div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t.sections.skills}</h2>
      <div class="mt-4"><SkillGrid /></div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t.sections.allProjects}</h2>
      <ul class="mt-4 space-y-4">
        {projects.filter((p) => p.featured).map((p) => (
          <li>
            <strong>{p.locales.en.title}</strong> — {p.locales.en.role}
            <p class="text-sm text-slate-600">{p.locales.en.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
