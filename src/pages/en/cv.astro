---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvInteractive from '../../components/CvInteractive.astro';
import CredentialsSection from '../../components/CredentialsSection.astro';
import SocialLinksIcons from '../../components/SocialLinksIcons.astro';
import { getUi } from '../../i18n/ui';
import { profile, cv } from '../../lib/data';

const locale = 'en';
const t = getUi(locale);
const primaryCv = profile.cvFiles.find((f) => f.primary) ?? profile.cvFiles[0];
---

<BaseLayout locale={locale} title={t.cv.title} description={cv.pitch[locale]} pathname={Astro.url.pathname}>
  <div class="page-shell-narrow">
    <!-- ── Encabezado ─────────────────────────────────────── -->
    <header class="flex flex-col gap-6 border-b border-slate-700/80 pb-8 sm:flex-row sm:items-start sm:gap-8">
      <img
        src={profile.photo}
        alt={profile.name}
        width="160"
        height="160"
        class="h-32 w-32 shrink-0 rounded-xl border-2 border-cyan-500/40 object-cover object-top shadow-glow sm:h-40 sm:w-40"
      />
      <div class="min-w-0 flex-1">
        <p class="section-label">// cv</p>
        <h1 class="mt-2 break-words font-display text-3xl font-bold text-white sm:text-4xl">{profile.name}</h1>
        <p class="mt-2 break-words font-mono text-xs text-cyan-400 sm:text-sm">{cv.headline[locale]}</p>
        <p class="mt-1 font-mono text-[11px] text-slate-500">{cv.location[locale]}</p>

        <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
          <a href={`mailto:${profile.email}`} class="break-all text-cyan-400 hover:text-cyan-300">{profile.email}</a>
          <a href={cv.whatsapp.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400">{cv.whatsapp.label}</a>
        </p>

        <div class="mt-3"><SocialLinksIcons locale={locale} /></div>

        <div class="no-print mt-5 flex flex-wrap gap-3">
          <a href={primaryCv.file} download class="btn-primary !w-auto !px-5 !py-2.5 !text-xs">{t.cv.download}</a>
          <button type="button" onclick="window.print()" class="btn-secondary !w-auto !px-5 !py-2.5 !text-xs">{t.cv.print}</button>
        </div>
      </div>
    </header>

    <!-- ── CV interactivo ─────────────────────────────────── -->
    <CvInteractive
      locale={locale}
      labels={{
        all: t.cv.all,
        filterHint: t.cv.filterHint,
        search: t.cv.search,
        searchPlaceholder: t.cv.searchPlaceholder,
        noResults: t.cv.noResults,
        experience: t.cv.experience,
        projects: t.cv.projects,
        stack: t.cv.stack,
        education: t.cv.education,
        courses: t.cv.courses,
        languages: t.cv.languages,
        expand: t.cv.expandAll,
        collapse: t.cv.collapseAll,
        expandAll: t.cv.expandAll,
        collapseAll: t.cv.collapseAll,
        current: t.cv.current,
        shareFacet: t.cv.shareFacet,
        copied: t.cv.copied,
        liveSite: t.cv.liveSite,
        repo: t.cv.repo,
        showing: t.cv.showing,
      }}
    />

    <!-- ── Títulos y certificados ─────────────────────────── -->
    <section class="mt-12">
      <h2 class="flex items-center gap-3 font-display text-lg font-bold text-white sm:text-xl">
        {t.sections.credentials}
      </h2>
      <div class="mt-5"><CredentialsSection locale={locale} downloadLabel={t.project.downloadCert} /></div>
    </section>
  </div>
</BaseLayout>
