---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import CredentialsSection from '../../components/CredentialsSection.astro';
import DegreesBadges from '../../components/DegreesBadges.astro';
import { getUi } from '../../i18n/ui';
import { profile, projects, socialLabels } from '../../lib/data';

const locale = 'en';
const t = getUi(locale);
const primaryCv = profile.cvFiles.find((f) => f.primary) ?? profile.cvFiles[0];
---

<BaseLayout locale={locale} title={t.cv.title} description={profile.bio.en} pathname={Astro.url.pathname}>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <div class="no-print mb-8 flex flex-wrap gap-3">
      <a href={primaryCv.file} download class="btn-primary">{t.cv.download}</a>
      {profile.cvFiles.filter((f) => !f.primary).map((cv) => (
        <a href={cv.file} download class="btn-secondary">{cv.locales[locale]}</a>
      ))}
      <button type="button" onclick="window.print()" class="btn-secondary">{t.cv.print}</button>
    </div>

    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <img
        src={profile.photo}
        alt={profile.name}
        width="160"
        height="160"
        class="h-40 w-40 shrink-0 rounded-xl border-2 border-cyan-500/40 object-cover object-top shadow-glow"
      />
      <header class="flex-1 border-b border-slate-700/80 pb-8">
        <p class="section-label">// cv</p>
        <h1 class="mt-2 font-display text-4xl font-bold text-white">{profile.name}</h1>
        <p class="mt-2 font-mono text-sm text-cyan-400">{profile.title.en}</p>
        <div class="mt-3"><DegreesBadges locale={locale} /></div>
        <p class="mt-4 text-slate-300">{profile.bio.en}</p>
        <p class="mt-3 font-mono text-xs text-slate-500">
          <a href={`mailto:${profile.email}`} class="text-cyan-400">{profile.email}</a>
        </p>
        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-slate-500">
          {Object.entries(profile.social).map(([key, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400">
              {socialLabels[key]?.[locale]}
            </a>
          ))}
        </div>
      </header>
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-white">{t.sections.timeline}</h2>
      <div class="mt-4"><Timeline locale={locale} /></div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-white">{t.sections.skills}</h2>
      <div class="mt-4"><SkillGrid /></div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-white">{t.sections.credentials}</h2>
      <div class="mt-4"><CredentialsSection locale={locale} downloadLabel={t.project.downloadCert} /></div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-white">{t.sections.allProjects}</h2>
      <ul class="mt-4 space-y-4">
        {projects.filter((p) => p.featured).map((p) => (
          <li class="text-slate-300">
            <strong class="text-white">{p.locales.en.title}</strong> — {p.locales.en.role}
            {p.demoUrl && (
              <a href={p.demoUrl} class="ml-2 font-mono text-xs text-emerald-400" target="_blank" rel="noopener noreferrer">
                {p.demoUrl.replace('https://', '')}
              </a>
            )}
            <p class="text-sm text-slate-500">{p.locales.en.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
