---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getUi, localePath } from '../../../i18n/ui';
import { getLocalizedProject, formatDate } from '../../../i18n/utils';
import { projects, getProjectById } from '../../../lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id } }));
}

const locale = 'en';
const { id } = Astro.params;
const project = getProjectById(id!);

if (!project) return Astro.redirect(localePath('en', '/projects'));

const t = getUi(locale);
const info = getLocalizedProject(project, locale);
---

<BaseLayout locale={locale} title={info.title} description={info.summary} pathname={Astro.url.pathname}>
  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <a href={localePath('en', '/projects')} class="text-sm font-medium text-brand-600 hover:underline">← Projects</a>
    <p class="mt-6 text-sm font-semibold uppercase text-brand-600">{t.categories[project.category]}</p>
    <h1 class="mt-2 font-display text-4xl font-bold text-ink-900 dark:text-white">{info.title}</h1>
    <p class="mt-2 text-slate-500">{t.project.role}: {info.role}</p>
    <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300">{info.summary}</p>
    {project.githubDescription && (
      <p class="mt-4 text-slate-500 italic">{project.githubDescription}</p>
    )}
    <div class="mt-6 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="rounded-md bg-slate-100 px-3 py-1 text-sm dark:bg-slate-800">{tag}</span>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-4 text-sm text-slate-500">
      <span>★ {project.stars} {t.project.stars}</span>
      <span>{t.project.updated}: {formatDate(project.updatedAt, locale)}</span>
    </div>
    <div class="mt-8 flex gap-4">
      <a href={project.htmlUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">{t.project.viewRepo}</a>
      {project.demoUrl && (
        <a href={project.demoUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">{t.project.viewDemo}</a>
      )}
    </div>
  </article>
</BaseLayout>
