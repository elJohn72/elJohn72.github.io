---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getUi, localePath } from '../../../i18n/ui';
import { getLocalizedProject, formatDate } from '../../../i18n/utils';
import { projects, getProjectById } from '../../../lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id } }));
}

const locale = 'en';
const { id } = Astro.params;
const project = getProjectById(id!);

if (!project) return Astro.redirect(localePath('en', '/projects'));

const t = getUi(locale);
const info = getLocalizedProject(project, locale);
---

<BaseLayout locale={locale} title={info.title} description={info.summary} pathname={Astro.url.pathname}>
  <article class="page-shell-narrow min-w-0">
    <a href={localePath('en', '/projects')} class="font-mono text-xs text-cyan-500 hover:text-cyan-400">← cd ../projects</a>
    <p class="mt-6"><span class="tech-badge">{t.categories[project.category]}</span></p>
    <h1 class="mt-4 break-words font-display text-2xl font-bold text-white sm:text-3xl md:text-4xl">{info.title}</h1>
    <p class="mt-2 font-mono text-sm text-slate-500">{t.project.role}: <span class="text-cyan-400">{info.role}</span></p>
    <p class="mt-6 text-lg leading-relaxed text-slate-300">{info.summary}</p>
    {project.githubDescription && (
      <p class="mt-4 font-mono text-sm text-slate-500 italic">// {project.githubDescription}</p>
    )}
    <div class="mt-6 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="tech-tag">{tag}</span>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-4 font-mono text-xs text-slate-500">
      <span class="text-amber-500/90">★ {project.stars} {t.project.stars}</span>
      <span>{t.project.updated}: {formatDate(project.updatedAt, locale)}</span>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      {project.demoUrl && (
        <a href={project.demoUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">{t.project.viewDemo} ↗</a>
      )}
      {project.repo && (
        <a href={project.htmlUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">{t.project.viewRepo}</a>
      )}
    </div>
  </article>
</BaseLayout>
