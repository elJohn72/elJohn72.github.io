---
import type { Locale } from '../i18n/ui';
import { switchLocalePath } from '../i18n/ui';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const other: Locale = locale === 'es' ? 'en' : 'es';
const href = switchLocalePath(locale, other, pathname);
const label = other.toUpperCase();
---

<a
  href={href}
  class="rounded-lg border border-slate-700 bg-ink-850 px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-wider text-slate-400 transition hover:border-violet-500/40 hover:text-violet-300"
  hreflang={other}
  lang={other}
>
  {label}
</a>
