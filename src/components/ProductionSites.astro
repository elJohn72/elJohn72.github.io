---
import type { Locale } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  {profile.productionSites.map((site) => (
    <a
      href={site.url}
      class="card-surface group block transition hover:border-emerald-500/40"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="mb-2 flex items-center justify-between gap-2">
        <span class="tech-badge border-emerald-500/40 bg-emerald-500/10 text-emerald-300">LIVE</span>
        <span class="font-mono text-xs text-slate-500 group-hover:text-cyan-400">↗</span>
      </div>
      <h3 class="break-words font-display text-lg font-bold text-white sm:text-xl">{site.label}</h3>
      <p class="mt-1 break-all font-mono text-xs text-cyan-400/90 sm:text-sm">{site.url.replace('https://', '')}</p>
      <p class="mt-3 break-words text-sm leading-relaxed text-slate-400">{site.locales[locale]}</p>
    </a>
  ))}
</div>
