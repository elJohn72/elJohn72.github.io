---
import type { Locale } from '../i18n/ui';
import { getUi, localePath } from '../i18n/ui';
import { getLocalizedProject, formatDate, type MergedProject } from '../i18n/utils';

interface Props {
  project: MergedProject;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = getUi(locale);
const info = getLocalizedProject(project, locale);
const detailPath =
  locale === 'es'
    ? localePath('es', `/proyectos/${project.id}`)
    : localePath('en', `/projects/${project.id}`);
const categoryLabel = t.categories[project.category];
---

<article class="card-surface group flex h-full flex-col transition hover:-translate-y-1 hover:shadow-md">
  <div class="mb-3 flex items-start justify-between gap-2">
    <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-brand-900/40 dark:text-brand-200">
      {categoryLabel}
    </span>
    {project.stars > 0 && (
      <span class="text-xs text-slate-500">★ {project.stars}</span>
    )}
  </div>
  <h3 class="font-display text-xl font-semibold text-ink-900 dark:text-white">
    <a href={detailPath} class="hover:text-brand-600 dark:hover:text-brand-400">{info.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{info.summary}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.slice(0, 4).map((tag) => (
      <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">{tag}</span>
    ))}
  </div>
  <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
    <span>{formatDate(project.updatedAt, locale)}</span>
    <a href={detailPath} class="font-semibold text-brand-600 hover:underline dark:text-brand-400">→</a>
  </div>
</article>
