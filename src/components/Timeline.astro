---
import type { Locale } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ol class="relative space-y-8 border-l-2 border-brand-200 pl-8 dark:border-brand-800">
  {profile.timeline.map((item) => (
    <li class="relative">
      <span class="absolute -left-[2.05rem] top-1 flex h-4 w-4 items-center justify-center rounded-full bg-brand-500 ring-4 ring-white dark:ring-ink-950" />
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400">{item.year}</p>
      <h3 class="mt-1 font-display text-lg font-semibold text-ink-900 dark:text-white">{item.title[locale]}</h3>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{item.description[locale]}</p>
    </li>
  ))}
</ol>
