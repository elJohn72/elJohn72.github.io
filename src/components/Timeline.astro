---
import type { Locale } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ol class="relative ml-1 space-y-6 border-l border-cyan-500/30 pl-6 sm:ml-0 sm:space-y-8 sm:pl-8">
  {profile.timeline.map((item, i) => (
    <li class="relative min-w-0">
      <span
        class="absolute -left-[1.65rem] flex h-4 w-4 items-center justify-center rounded border border-cyan-500/50 bg-ink-900 font-mono text-[7px] text-cyan-400 shadow-glow sm:-left-[2.35rem] sm:h-5 sm:w-5 sm:text-[8px]"
        aria-hidden="true"
      >
        {String(i + 1).padStart(2, '0')}
      </span>
      <p class="break-words font-mono text-[10px] font-semibold uppercase tracking-widest text-cyan-500/80">{item.year}</p>
      <h3 class="mt-1 break-words font-display text-base font-bold text-white sm:text-lg">{item.title[locale]}</h3>
      <p class="mt-1 break-words text-sm leading-relaxed text-slate-400">{item.description[locale]}</p>
    </li>
  ))}
</ol>
