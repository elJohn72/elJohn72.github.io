---
import type { Locale } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ol class="relative space-y-8 border-l border-cyan-500/30 pl-8">
  {profile.timeline.map((item, i) => (
    <li class="relative">
      <span
        class="absolute -left-[2.35rem] flex h-5 w-5 items-center justify-center rounded border border-cyan-500/50 bg-ink-900 font-mono text-[8px] text-cyan-400 shadow-glow"
        aria-hidden="true"
      >
        {String(i + 1).padStart(2, '0')}
      </span>
      <p class="font-mono text-[10px] font-semibold uppercase tracking-widest text-cyan-500/80">{item.year}</p>
      <h3 class="mt-1 font-display text-lg font-bold text-white">{item.title[locale]}</h3>
      <p class="mt-1 text-sm text-slate-400">{item.description[locale]}</p>
    </li>
  ))}
</ol>
