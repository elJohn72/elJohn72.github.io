const entries = Object.entries(profile.social).filter(([k]) => ICONS[k]);
---

<ul class="flex flex-wrap gap-2">
  {entries.map(([key, url]) => (
    <li>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['social-pill', key === 'github' && 'social-pill--primary']}
        aria-label={socialLabels[key]?.[locale] ?? key}
      >
        <svg class="h-4 w-4 shrink-0" viewBox={ICONS[key].box} fill="currentColor" aria-hidden="true">
          <path d={ICONS[key].d} />
        </svg>
        <span>{socialLabels[key]?.[locale] ?? key}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-pill {
    @apply inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-700 bg-ink-850 px-3 py-2 font-mono text-xs font-medium text-slate-400 transition hover:-translate-y-0.5 hover:border-cyan-500/50 hover:text-cyan-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400;
  }
  .social-pill--primary {
    @apply border-cyan-400/50 bg-cyan-500/10 font-semibold text-cyan-300 shadow-glow;
  }
  @media (prefers-reduced-motion: reduce) {
    .social-pill:hover { transform: none; }
  }
</style>
