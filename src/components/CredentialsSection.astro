---
import type { Locale } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
  downloadLabel: string;
}

const { locale, downloadLabel } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2">
  {profile.credentials.map((cred) => (
    <article class="card-surface flex h-full flex-col">
      <p class="font-mono text-[10px] uppercase tracking-widest text-cyan-500/80">{cred.year}</p>
      <h3 class="mt-2 font-display text-lg font-bold text-white">{cred.locales[locale].title}</h3>
      <p class="mt-1 flex-1 text-sm text-slate-400">{cred.locales[locale].issuer}</p>
      <a
        href={cred.file}
        class="btn-secondary mt-4 w-full text-center text-xs"
        target="_blank"
        rel="noopener noreferrer"
        download
      >
        {downloadLabel}
      </a>
    </article>
  ))}
</div>
