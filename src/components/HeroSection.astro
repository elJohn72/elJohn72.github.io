---
import type { Locale } from '../i18n/ui';
import { localePath } from '../i18n/ui';
import { profile } from '../lib/data';
import DegreesBadges from './DegreesBadges.astro';

interface Props {
  locale: Locale;
  ctaProjects: string;
  ctaCv: string;
  ctaContact: string;
}

const { locale, ctaProjects, ctaCv, ctaContact } = Astro.props;
const statusLabel = locale === 'es' ? 'sistema en línea' : 'system online';
const stackItems =
  locale === 'es'
    ? ['HigieneDental', 'Ing.Electromecánico', 'Ing.TI_OTI']
    : ['DentalHygiene', 'Electromechanical', 'IT_OTI'];
---

<section class="relative overflow-hidden border-b border-slate-800/80">
  <div class="page-shell grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-10 lg:gap-12">
    <div class="relative z-10 min-w-0 order-2 md:order-1">
      <div class="mb-4 flex flex-wrap items-center gap-2 font-mono text-[10px] text-slate-400 sm:gap-3 sm:text-xs">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="text-emerald-400">{statusLabel}</span>
        <span class="text-slate-600">|</span>
        <span class="text-cyan-400/80">v2.0.0</span>
      </div>

      <p class="section-label mb-2">
        {locale === 'es' ? '// portafolio técnico' : '// technical portfolio'}
      </p>

      <h1 class="font-display text-3xl font-bold leading-[1.1] tracking-tight break-words sm:text-4xl md:text-5xl lg:text-6xl">
        <span class="bg-gradient-to-r from-cyan-400 via-white to-violet-400 bg-clip-text text-transparent">
          {profile.name}
        </span>
      </h1>

      <p class="mt-3 break-words font-mono text-xs leading-relaxed text-cyan-400/90 sm:mt-4 sm:text-sm md:text-base">
        &gt; {profile.title[locale]}
      </p>

      <div class="mt-3 sm:mt-4">
        <DegreesBadges locale={locale} />
      </div>

      <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-300 sm:mt-4 sm:text-base">
        {profile.bio[locale]}
      </p>

      <ul class="mt-5 space-y-2 font-mono text-[11px] text-slate-500 sm:mt-6 sm:text-xs md:text-sm">
        {profile.highlights[locale].map((h) => (
          <li class="flex gap-2">
            <span class="shrink-0 text-cyan-500" aria-hidden="true">{'>'}</span>
            <span class="min-w-0 break-words">{h}</span>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap">
        <a href={locale === 'es' ? localePath('es', '/proyectos') : localePath('en', '/projects')} class="btn-primary">
          {ctaProjects}
        </a>
        <a href={localePath(locale, '/cv')} class="btn-secondary">{ctaCv}</a>
        <a href={locale === 'es' ? localePath('es', '/contacto') : localePath('en', '/contact')} class="btn-secondary">
          {ctaContact}
        </a>
      </div>
    </div>

    <div class="relative z-10 flex min-w-0 justify-center order-1 md:order-2">
      <div class="terminal-window max-w-full sm:max-w-sm">
        <div class="flex min-w-0 items-center gap-2 border-b border-slate-700/80 px-3 py-2.5 sm:px-4 sm:py-3">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-red-500/80 sm:h-3 sm:w-3" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-amber-400/80 sm:h-3 sm:w-3" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-400/80 sm:h-3 sm:w-3" aria-hidden="true"></span>
          <span class="ml-1 truncate font-mono text-[10px] text-slate-500 sm:ml-2">~/eljohn72</span>
        </div>
        <div class="min-w-0 space-y-1 overflow-hidden p-3 text-[11px] leading-relaxed text-slate-400 sm:p-4 sm:text-xs md:p-5 md:text-sm">
          <p class="break-words">
            <span class="text-violet-400">const</span> <span class="text-cyan-300">profile</span> = {'{'}
          </p>
          <p class="break-words pl-3 sm:pl-4">
            <span class="text-slate-500">name:</span> <span class="text-emerald-400">"John Miraba"</span>,
          </p>
          <p class="pl-3 sm:pl-4"><span class="text-slate-500">stack:</span> <span class="text-amber-300">[</span></p>
          {stackItems.map((item, index) => (
            <p class="break-words pl-6 sm:pl-8">
              <span class="text-amber-300">
                "{item}"{index < stackItems.length - 1 ? ',' : ''}
              </span>
            </p>
          ))}
          <p class="pl-3 sm:pl-4"><span class="text-amber-300">],</span></p>
          <p class="break-words pl-3 sm:pl-4">
            <span class="text-slate-500">status:</span> <span class="text-emerald-400">"building"</span>
          </p>
          <p>{'}'}</p>
          <div class="mt-3 flex justify-center pt-1 sm:mt-4 sm:pt-2">
            <img
              src={profile.photo}
              alt={profile.name}
              width="200"
              height="200"
              class="h-36 w-36 max-w-[85vw] rounded-lg border-2 border-cyan-500/40 object-cover object-top shadow-glow sm:h-44 sm:w-44 md:h-48 md:w-48"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
