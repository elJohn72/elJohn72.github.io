---
import type { Locale } from '../i18n/ui';
import { localePath } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
  ctaProjects: string;
  ctaCv: string;
  ctaContact: string;
}

const { locale, ctaProjects, ctaCv, ctaContact } = Astro.props;
const statusLabel = locale === 'es' ? 'sistema en línea' : 'system online';
const roleLabel = locale === 'es' ? 'odontología · robótica · dev' : 'dentistry · robotics · dev';
---

<section class="relative overflow-hidden border-b border-slate-800/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:items-center md:px-6 md:py-24">
    <div class="relative z-10">
      <div class="mb-4 flex items-center gap-3 font-mono text-xs text-slate-400">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="text-emerald-400">{statusLabel}</span>
        <span class="text-slate-600">|</span>
        <span class="text-cyan-400/80">v1.0.0</span>
      </div>

      <p class="section-label mb-2">
        {locale === 'es' ? '// portafolio técnico' : '// technical portfolio'}
      </p>

      <h1 class="font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-6xl">
        <span class="bg-gradient-to-r from-cyan-400 via-white to-violet-400 bg-clip-text text-transparent">
          {profile.name}
        </span>
      </h1>

      <p class="mt-4 font-mono text-sm text-cyan-400/90 md:text-base">
        &gt; {profile.title[locale]}
      </p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-300">
        {profile.bio[locale]}
      </p>

      <ul class="mt-6 space-y-2 font-mono text-xs text-slate-500 md:text-sm">
        {profile.highlights[locale].map((h) => (
          <li class="flex gap-2">
            <span class="text-cyan-500" aria-hidden="true">{'>'}</span>
            <span>{h}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={locale === 'es' ? localePath('es', '/proyectos') : localePath('en', '/projects')} class="btn-primary">
          {ctaProjects}
        </a>
        <a href={localePath(locale, '/cv')} class="btn-secondary">{ctaCv}</a>
        <a href={locale === 'es' ? localePath('es', '/contacto') : localePath('en', '/contact')} class="btn-secondary">
          {ctaContact}
        </a>
      </div>
    </div>

    <div class="relative z-10 flex justify-center">
      <div class="terminal-window w-full max-w-sm p-1">
        <div class="flex items-center gap-2 border-b border-slate-700/80 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-500/80" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-amber-400/80" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-400/80" aria-hidden="true"></span>
          <span class="ml-2 font-mono text-[10px] text-slate-500">~/eljohn72</span>
        </div>
        <div class="space-y-2 p-5 text-slate-400">
          <p><span class="text-violet-400">const</span> <span class="text-cyan-300">builder</span> = {'{'}</p>
          <p class="pl-4"><span class="text-slate-500">role:</span> <span class="text-emerald-400">"{roleLabel}"</span>,</p>
          <p class="pl-4"><span class="text-slate-500">stack:</span> <span class="text-amber-300">["IoT","EdTech","Health"]</span>,</p>
          <p class="pl-4"><span class="text-slate-500">status:</span> <span class="text-emerald-400">"shipping"</span></p>
          <p>{'}'}</p>
          <div class="mt-4 flex justify-center pt-2">
            <img
              src={profile.photo}
              alt={profile.name}
              width="200"
              height="200"
              class="h-48 w-48 rounded-lg border-2 border-cyan-500/40 object-cover object-top shadow-glow"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
