---
import type { Locale } from '../i18n/ui';
import { getUi } from '../i18n/ui';
import { profile, socialLabels } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-slate-800/80 bg-ink-950/80 backdrop-blur-md">
  <div class="page-shell !py-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="flex flex-col gap-3">
        <img src="/images/logo.svg" alt="eljhon72" width="160" height="28" class="h-7 w-auto opacity-80" loading="lazy" />
        <p class="font-mono text-xs text-slate-500">
          <span class="text-cyan-500/80">©</span> {year} {profile.name}
          <span class="text-slate-600"> — </span>
          {t.footer.rights}
        </p>
      </div>
      <div class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs">
        {Object.entries(profile.social).map(([key, url]) => (
          <a href={url} class="text-slate-400 transition hover:text-cyan-400" target="_blank" rel="noopener noreferrer">
            {socialLabels[key]?.[locale] ?? key}
          </a>
        ))}
        <a href={`mailto:${profile.email}`} class="break-all text-slate-400 transition hover:text-cyan-400">
          {profile.email}
        </a>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-4 border-t border-slate-800/80 pt-6 font-mono text-xs">
      {profile.productionSites.map((site) => (
        <a href={site.url} class="text-emerald-400/90 transition hover:text-emerald-300" target="_blank" rel="noopener noreferrer">
          {site.url.replace('https://', '')} ↗
        </a>
      ))}
    </div>
  </div>
</footer>
