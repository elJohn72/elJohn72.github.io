---
import type { Locale } from '../i18n/ui';
import { getUi } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-slate-800/80 bg-ink-950/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-between md:px-6">
    <div class="flex flex-col gap-3">
      <img src="/images/logo.svg" alt="eljhon72" width="160" height="28" class="h-7 w-auto opacity-80" loading="lazy" />
      <p class="font-mono text-xs text-slate-500">
        <span class="text-cyan-500/80">©</span> {year} {profile.name}
        <span class="text-slate-600"> — </span>
        {t.footer.rights}
      </p>
    </div>
    <div class="flex flex-wrap gap-4 font-mono text-xs">
      <a
        href={profile.social.github}
        class="text-slate-400 transition hover:text-cyan-400"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        href={profile.social.linkedin}
        class="text-slate-400 transition hover:text-violet-400"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a href={`mailto:${profile.email}`} class="text-slate-400 transition hover:text-cyan-400">
        {profile.email}
      </a>
    </div>
  </div>
</footer>
