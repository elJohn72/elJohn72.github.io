<button
  id="theme-toggle"
  type="button"
  class="rounded-lg border border-slate-700 bg-ink-850 p-2 font-mono text-xs text-slate-400 transition hover:border-cyan-500/40 hover:text-cyan-400"
  aria-label="Toggle theme"
>
  <span class="theme-icon-dark hidden dark:inline" aria-hidden="true">◐</span>
  <span class="theme-icon-light inline dark:hidden" aria-hidden="true">◑</span>
</button>

<script>
  const storageKey = 'portfolio-theme';
  const root = document.documentElement;

  function applyTheme(theme: 'light' | 'dark') {
    if (theme === 'dark') root.classList.add('dark');
    else root.classList.remove('dark');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    applyTheme(next);
    localStorage.setItem(storageKey, next);
  });
</script>
