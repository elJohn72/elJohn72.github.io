---
import { profile } from '../lib/data';
---

<div class="grid gap-4 sm:grid-cols-2">
  {profile.skills.map((skill) => (
    <div class="card-surface">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
        <span class="min-w-0 break-words text-slate-300">{skill.name}</span>
        <span class="text-cyan-400">{skill.level}%</span>
      </div>
      <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
        <div
          class="h-full rounded-full bg-gradient-to-r from-cyan-500 via-cyan-400 to-violet-500 shadow-[0_0_12px_rgba(34,211,238,0.5)]"
          style={`width: ${skill.level}%`}
          role="progressbar"
          aria-valuenow={skill.level}
          aria-valuemin={0}
          aria-valuemax={100}
        />
      </div>
    </div>
  ))}
</div>
