---
import type { Locale } from '../i18n/ui';
import { getUi } from '../i18n/ui';
import { categories } from '../lib/data';

interface Props {
  locale: Locale;
  activeCategory?: string;
}

const { locale, activeCategory = 'all' } = Astro.props;
const t = getUi(locale);

const btnClass = (active: boolean) =>
  active
    ? 'filter-btn filter-btn-active rounded-lg border px-4 py-2 text-sm transition'
    : 'filter-btn filter-btn-inactive rounded-lg border px-4 py-2 text-sm transition';
---

<div class="flex flex-wrap gap-2" id="category-filters" role="tablist" aria-label="Project categories">
  <button type="button" data-category="all" class={btnClass(activeCategory === 'all')}>
    {t.sections.filterAll}
  </button>
  {categories.map((cat) => (
    <button type="button" data-category={cat} class={btnClass(activeCategory === cat)}>
      {t.categories[cat]}
    </button>
  ))}
</div>

<script>
  const grid = document.getElementById('projects-grid');
  const buttons = document.querySelectorAll('.filter-btn');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');
      buttons.forEach((b) => {
        b.classList.remove('filter-btn-active');
        b.classList.add('filter-btn-inactive');
      });
      btn.classList.add('filter-btn-active');
      btn.classList.remove('filter-btn-inactive');

      grid?.querySelectorAll('[data-project-category]').forEach((card) => {
        const cardCat = card.getAttribute('data-project-category');
        const show = category === 'all' || cardCat === category;
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>
