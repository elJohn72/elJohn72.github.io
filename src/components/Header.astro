---
import type { Locale } from '../i18n/ui';
import { getUi, localePath } from '../i18n/ui';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = getUi(locale);

const links =
  locale === 'es'
    ? [
        { href: localePath('es', '/'), label: t.nav.home },
        { href: localePath('es', '/proyectos'), label: t.nav.projects },
        { href: localePath('es', '/sobre-mi'), label: t.nav.about },
        { href: localePath('es', '/cv'), label: t.nav.cv },
        { href: localePath('es', '/contacto'), label: t.nav.contact },
      ]
    : [
        { href: localePath('en', '/'), label: t.nav.home },
        { href: localePath('en', '/projects'), label: t.nav.projects },
        { href: localePath('en', '/about'), label: t.nav.about },
        { href: localePath('en', '/cv'), label: t.nav.cv },
        { href: localePath('en', '/contact'), label: t.nav.contact },
      ];

const isActive = (href: string) =>
  pathname === href || (href !== `/${locale}/` && pathname.startsWith(href));

const menuLabel = locale === 'es' ? 'Abrir menú' : 'Open menu';
---

<header class="sticky top-0 z-50 border-b border-slate-800/80 bg-ink-950/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl min-w-0 items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href={localePath(locale, '/')} class="group shrink-0 transition opacity-90 hover:opacity-100">
      <img
        src="/images/logo.svg"
        alt="eljhon72"
        width="200"
        height="36"
        class="h-7 w-auto sm:h-8 md:h-9"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden min-w-0 items-center gap-1 lg:flex" aria-label="Main">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-3 py-2 font-mono text-xs transition',
            isActive(link.href)
              ? 'border border-cyan-500/30 bg-cyan-500/10 text-cyan-300'
              : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <LocaleSwitcher locale={locale} pathname={pathname} />
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 bg-ink-850 text-slate-300 transition hover:border-cyan-500/40 hover:text-cyan-300 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label={menuLabel}
      >
        <svg id="icon-menu" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu-panel"
    class="hidden border-t border-slate-800/80 bg-ink-950/95 px-4 py-3 lg:hidden"
    hidden
  >
    <nav class="flex flex-col gap-1" aria-label={locale === 'es' ? 'Menú móvil' : 'Mobile menu'}>
      {links.map((link) => (
        <a
          href={link.href}
          data-mobile-nav-link
          class:list={[
            'flex min-h-11 items-center rounded-lg px-4 py-3 font-mono text-sm transition',
            isActive(link.href)
              ? 'border border-cyan-500/30 bg-cyan-500/10 text-cyan-300'
              : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  const setOpen = (open: boolean) => {
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute(
      'aria-label',
      open
        ? document.documentElement.lang === 'es'
          ? 'Cerrar menú'
          : 'Close menu'
        : document.documentElement.lang === 'es'
          ? 'Abrir menú'
          : 'Open menu',
    );
    panel.classList.toggle('hidden', !open);
    panel.hidden = !open;
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  panel?.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
